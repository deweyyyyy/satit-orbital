{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "satit-orbital",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  // Leaderboard. Replace database_id with the id printed by: npx wrangler d1 create satit-orbital
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "satit-orbital",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // One Durable Object per online co-op room (up to 4 players).
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "MissionRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MissionRoom"] }],
  "observability": { "enabled": true }
}
