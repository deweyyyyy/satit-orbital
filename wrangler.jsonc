{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "satit-orbital",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  // Custom domain (the domain is on the same Cloudflare account). The workers.dev URL keeps working too.
  "routes": [{ "pattern": "satit-orbital.deweysworld.app", "custom_domain": true }],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  // Leaderboard (D1). For your own copy, create a database with: npx wrangler d1 create satit-orbital, and put its id here.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "satit-orbital",
      "database_id": "b633f4c4-c4e2-464b-bbf4-22fccb6d4d50",
      "migrations_dir": "migrations"
    }
  ],
  // One Durable Object per online co-op room (up to 4 players).
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "MissionRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MissionRoom"] }],
  "observability": { "enabled": true }
}
