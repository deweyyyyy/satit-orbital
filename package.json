{
  "name": "satit-orbital",
  "version": "1.0.0",
  "private": true,
  "description": "SATIT Orbital: a space mission design game for the 2026 NASA Space Apps Challenge.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "node --test test/*.test.js",
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply satit-orbital --local",
    "db:migrate:remote": "wrangler d1 migrations apply satit-orbital --remote",
    "deploy": "wrangler deploy",
    "check": "wrangler deploy --dry-run --outdir=dist",
    "test:smoke": "node test/api-smoke.mjs",
    "vendor:three": "cp node_modules/three/build/three.module.min.js public/vendor/ && cp node_modules/three/LICENSE public/vendor/three.LICENSE.txt",
    "provenance": "node scripts/provenance.mjs generate v1.0-submitted",
    "verify": "node scripts/provenance.mjs verify"
  },
  "devDependencies": {
    "three": "0.170.0",
    "wrangler": "^4.40.0"
  }
}
